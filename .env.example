# 서버 전용. NEXT_PUBLIC_ 접두사를 붙이지 않는다 (CLAUDE.md Supabase 연동 규칙)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# 공개 스토리지 주소. 테이블에는 파일 경로(<uuid>.jpg)만 저장한다.
SUPABASE_STORAGE_URL=https://<project-ref>.supabase.co/storage/v1/object/public

# 장소 검색: 네이버 클라우드 플랫폼 > API Hub > 검색(지역)의 Client ID / Client Secret (GET /api/places/search)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# 지도 이미지: 네이버 클라우드 플랫폼 > Maps > Static Map (GET /api/map). 없으면 일러스트 지도로 대신한다.
# 같은 키로 Reverse Geocoding(GET /api/places/address, 지도 핀 위치 → 주소)도 부른다. Application에서 Reverse Geocoding을 켜야 한다.
NCP_MAP_KEY_ID=
NCP_MAP_KEY=
# 움직이는 지도: 같은 애플리케이션의 Dynamic Map (장소 등록 > 위치 지정). 값은 NCP_MAP_KEY_ID와 같다.
# 브라우저 SDK가 쓰는 공개 Client ID라 NEXT_PUBLIC_을 붙인다(Secret은 넣지 않는다).
# NCP 콘솔 > Application > Web 서비스 URL에 http://localhost:3000 과 배포 주소를 등록해야 지도가 뜬다.
NEXT_PUBLIC_NCP_MAP_KEY_ID=
