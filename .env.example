# 서버 전용. NEXT_PUBLIC_ 접두사를 붙이지 않는다 (CLAUDE.md Supabase 연동 규칙)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# 공개 스토리지 주소. 테이블에는 파일 경로(<uuid>.jpg)만 저장한다.
SUPABASE_STORAGE_URL=https://<project-ref>.supabase.co/storage/v1/object/public

# 장소 검색: 네이버 클라우드 플랫폼 > API Hub > 검색(지역)의 Client ID / Client Secret (GET /api/places/search)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# 지도 이미지: 네이버 클라우드 플랫폼 > Maps > Static Map (GET /api/map). 없으면 일러스트 지도로 대신한다.
# 같은 키로 Reverse Geocoding(GET /api/places/address, 지도 핀 위치 → 주소)도 부른다. Application에서 Reverse Geocoding을 켜야 한다.
NCP_MAP_KEY_ID=
NCP_MAP_KEY=
# 움직이는 지도: 같은 애플리케이션의 Dynamic Map (장소 등록 > 위치 지정). 값은 NCP_MAP_KEY_ID와 같다.
# 브라우저 SDK가 쓰는 공개 Client ID라 NEXT_PUBLIC_을 붙인다(Secret은 넣지 않는다).
# NCP 콘솔 > Application > Web 서비스 URL에 http://localhost:3000 과 배포 주소를 등록해야 지도가 뜬다.
NEXT_PUBLIC_NCP_MAP_KEY_ID=

# 결제: PortOne(포트원) V2. 규칙은 rules/payment.md. 모두 서버 전용이라 NEXT_PUBLIC_을 붙이지 않는다.
# 상점 아이디·채널 키: 포트원 콘솔 > 결제 연동 > 연동 정보 (결제창을 열 때 서버가 결제 버튼에 넘긴다)
PORTONE_STORE_ID=store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PORTONE_CHANNEL_KEY=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# V2 API Secret: 포트원 콘솔 > 결제 연동 > 연동 정보 > API Keys (결제 조회·취소. 절대 브라우저로 보내지 않는다)
PORTONE_API_SECRET=

# 결제 웹훅(POST /api/payments/webhook). 규칙은 rules/payment.md. 둘 다 서버 전용이고 절대 브라우저로 보내지 않는다.
# 웹훅 서명 시크릿: 포트원 콘솔 > 결제 연동 > 연동 관리 > 결제알림(Webhook) 관리 > 결제모듈 V2 > 웹훅 시크릿 발급 (테스트·실연동 따로)
PORTONE_WEBHOOK_SECRET=
# Supabase secret key(RLS 우회): 대시보드 > Project Settings > API Keys > Secret keys (sb_secret_...)
# 결제 기록(payment·product_snapshot) 쓰기와 웹훅에서만 쓴다(lib/supabase/server.ts createSupabaseAdminClient).
SUPABASE_SECRET_KEY=sb_secret_xxx
